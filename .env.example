# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ должен попадать в git (см. .gitignore).

# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-value

DATABASE_URL=sqlite:///database.db

# Если true — приложение не запустится без SECRET_KEY из окружения
FLASK_ENV=production
